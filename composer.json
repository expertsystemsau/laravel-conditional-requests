{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "expertsystemsau/laravel-conditional-requests",
    "description": "HTTP conditional requests for Laravel \u2014 ETag, Last-Modified, 304 Not Modified, and lost-update protection with If-Match.",
    "keywords": [
        "laravel",
        "php",
        "http",
        "conditional-requests",
        "etag",
        "etags",
        "last-modified",
        "if-match",
        "if-none-match",
        "if-modified-since",
        "http-cache",
        "http-caching",
        "not-modified",
        "optimistic-locking",
        "concurrency-control",
        "middleware",
        "rest-api",
        "api"
    ],
    "homepage": "https://github.com/expertsystemsau/laravel-conditional-requests",
    "license": "MIT",
    "authors": [
        {
            "name": "Mitchell Williams",
            "email": "mitchell@expertsystems.com.au",
            "homepage": "https://expertsystems.com.au",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/expertsystemsau/laravel-conditional-requests/issues",
        "source": "https://github.com/expertsystemsau/laravel-conditional-requests",
        "docs": "https://github.com/expertsystemsau/laravel-conditional-requests#readme",
        "security": "https://github.com/expertsystemsau/laravel-conditional-requests/blob/main/.github/SECURITY.md"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/routing": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "symfony/http-foundation": "^7.2||^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "ExpertSystems\\ConditionalRequests\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ExpertSystems\\ConditionalRequests\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test:lock": [
            "@php vendor/bin/pest --filter=RowLockContentionTest"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "ExpertSystems\\ConditionalRequests\\ConditionalRequestsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
